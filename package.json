{
  "name": "orbit-share-pwa",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "build": "node scripts/build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.sw.json && node scripts/version.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "lossless-json": "4.3.3"
  }
}
